generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Status/role columns use String to match legacy Neon VARCHAR columns (not PG enums)

model User {
  id                   String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email                String                @unique
  passwordHash         String                @map("password_hash")
  fullName             String                @map("full_name")
  studentId            String                @unique @map("student_id")
  phone                String?
  role                 String                @default("STUDENT")
  loyaltyPoints        Int                   @default(0) @map("loyalty_points")
  loyaltyTier          String                @default("BRONZE") @map("loyalty_tier")
  emailVerified        Boolean               @default(false) @map("email_verified")
  emailVerifyToken     String?               @map("email_verify_token")
  photoUrl             String?               @map("photo_url")
  isActive             Boolean               @default(true) @map("is_active")
  passwordResetToken   String?               @map("password_reset_token")
  passwordResetExpires DateTime?             @map("password_reset_expires") @db.Timestamptz(6)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  dietaryPreferences   UserDietaryPreference?
  allergies            UserAllergy[]
  orders               Order[]
  cartItems            CartItem[]
  loyaltyTransactions  LoyaltyTransaction[]
  refreshTokens        RefreshToken[]
  notifications        Notification[]
  paymentRecords       PaymentRecord[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model UserDietaryPreference {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  vegetarian  Boolean  @default(false)
  vegan       Boolean  @default(false)
  glutenFree  Boolean  @default(false) @map("gluten_free")
  dairyFree   Boolean  @default(false) @map("dairy_free")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_dietary_preferences")
}

model UserAllergy {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  allergyName String   @map("allergy_name")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_allergies")
}

model MenuCategory {
  id          String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String
  description String?
  sortOrder   Int        @default(0) @map("sort_order")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  menuItems   MenuItem[]

  @@map("menu_categories")
}

model MenuItem {
  id              String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name            String
  description     String?
  price           Decimal          @db.Decimal(10, 2)
  categoryId      String?          @map("category_id") @db.Uuid
  imageUrl        String?          @map("image_url")
  emoji           String?
  calories        Int?
  protein         Decimal?         @db.Decimal(5, 1)
  carbs           Decimal?         @db.Decimal(5, 1)
  fat             Decimal?         @db.Decimal(5, 1)
  customizable    Boolean          @default(true)
  available       Boolean          @default(true)
  prepTimeMinutes Int              @default(15) @map("prep_time_minutes")
  isSpecial       Boolean          @default(false) @map("is_special")
  dietaryTags     String[]         @default([]) @map("dietary_tags")
  allergens       String[]         @default([])
  stockQuantity   Int?             @map("stock_quantity")
  isPopular       Boolean          @default(false) @map("is_popular")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  category        MenuCategory?    @relation(fields: [categoryId], references: [id])
  options         MenuItemOption[]
  orderItems      OrderItem[]
  cartItems       CartItem[]

  @@index([categoryId])
  @@index([available])
  @@map("menu_items")
}

model MenuItemOption {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  menuItemId    String   @map("menu_item_id") @db.Uuid
  optionType    String   @map("option_type")
  optionName    String   @map("option_name")
  priceModifier Decimal  @default(0) @map("price_modifier") @db.Decimal(10, 2)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  menuItem      MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@map("menu_item_options")
}

model Order {
  id              String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  totalAmount     Decimal          @map("total_amount") @db.Decimal(10, 2)
  subtotal        Decimal          @default(0) @db.Decimal(10, 2)
  taxAmount       Decimal          @default(0) @map("tax_amount") @db.Decimal(10, 2)
  discountAmount  Decimal          @default(0) @map("discount_amount") @db.Decimal(10, 2)
  pointsRedeemed  Int              @default(0) @map("points_redeemed")
  status          String           @default("PLACED")
  estimatedTime   DateTime?        @map("estimated_time") @db.Timestamptz(6)
  cancelDeadline  DateTime?        @map("cancel_deadline") @db.Timestamptz(6)
  notes           String?
  pickupType      String           @default("ASAP") @map("pickup_type")
  scheduledPickup DateTime?        @map("scheduled_pickup") @db.Timestamptz(6)
  paymentMethod   String           @default("online") @map("payment_method")
  rejectionReason String?          @map("rejection_reason")
  rating          Int?
  review          String?
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user            User             @relation(fields: [userId], references: [id])
  items           OrderItem[]
  loyaltyTransactions LoyaltyTransaction[]
  paymentRecords  PaymentRecord[]
  notifications   Notification[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  menuItemId     String?  @map("menu_item_id") @db.Uuid
  quantity       Int
  unitPrice      Decimal  @map("unit_price") @db.Decimal(10, 2)
  totalPrice     Decimal  @map("total_price") @db.Decimal(10, 2)
  customizations Json?
  itemName       String?  @map("item_name")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem       MenuItem? @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model CartItem {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  menuItemId     String   @map("menu_item_id") @db.Uuid
  quantity       Int
  customizations Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  menuItem       MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([userId, menuItemId])
  @@index([userId])
  @@map("cart_items")
}

model LoyaltyTransaction {
  id              String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId          String                 @map("user_id") @db.Uuid
  orderId         String?                @map("order_id") @db.Uuid
  pointsEarned    Int                    @default(0) @map("points_earned")
  pointsRedeemed  Int                    @default(0) @map("points_redeemed")
  transactionType String                 @map("transaction_type")
  description     String?
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  user            User                   @relation(fields: [userId], references: [id])
  order           Order?                 @relation(fields: [orderId], references: [id])

  @@index([userId])
  @@map("loyalty_transactions")
}

model LoyaltyConfig {
  id                  String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  pointsPerDollar     Int      @default(1) @map("points_per_dollar")
  redeemPointsPerUnit Int      @default(100) @map("redeem_points_per_unit")
  redeemValueCents    Int      @default(500) @map("redeem_value_cents")
  bronzeMultiplier    Decimal  @default(1.0) @map("bronze_multiplier") @db.Decimal(3, 2)
  silverMultiplier    Decimal  @default(1.25) @map("silver_multiplier") @db.Decimal(3, 2)
  goldMultiplier      Decimal  @default(1.5) @map("gold_multiplier") @db.Decimal(3, 2)
  silverThreshold     Int      @default(500) @map("silver_threshold")
  goldThreshold       Int      @default(1500) @map("gold_threshold")
  cancelWindowMinutes Int      @default(5) @map("cancel_window_minutes")
  maxOrderItems       Int      @default(20) @map("max_order_items")
  taxRate             Decimal  @default(0.08) @map("tax_rate") @db.Decimal(5, 4)
  pointsExpirationDays Int     @default(365) @map("points_expiration_days")
  maxCartValue        Decimal  @default(200) @map("max_cart_value") @db.Decimal(10, 2)
  doublePointsEnabled Boolean  @default(false) @map("double_points_enabled")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("loyalty_config")
}

model SystemSettings {
  id                    String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  canteenOpenTime       String   @default("07:00") @map("canteen_open_time")
  canteenCloseTime      String   @default("21:00") @map("canteen_close_time")
  canteenIsOpen         Boolean  @default(true) @map("canteen_is_open")
  universityEmailDomain String   @default("@university.edu") @map("university_email_domain")
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("system_settings")
}

model InviteCode {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  code      String    @unique
  role      String    @default("STAFF")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedBy    String?   @map("used_by") @db.Uuid
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([code])
  @@map("invite_codes")
}

model PaymentRecord {
  id              String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orderId         String        @map("order_id") @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  amount          Decimal       @db.Decimal(10, 2)
  status          String        @default("PENDING")
  stripePaymentId String?       @map("stripe_payment_id")
  paymentMethod   String        @default("mock") @map("payment_method")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  order           Order         @relation(fields: [orderId], references: [id])
  user            User          @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@map("payment_records")
}

model Notification {
  id        String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  orderId   String?          @map("order_id") @db.Uuid
  type      String           @default("SYSTEM")
  title     String
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     Order?           @relation(fields: [orderId], references: [id])

  @@index([userId])
  @@map("notifications")
}
